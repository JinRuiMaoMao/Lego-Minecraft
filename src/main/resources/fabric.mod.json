{
	"schemaVersion": 1,
	"id": "legominecraft",
	"version": "${version}",
	"name": "Lego Minecraft",
	"description": "Build with real LEGO parts at 1:1 scale: 324 official parts in 26 colours, stud snapping, multi-part blocks, Technic, bars and clips.",
	"authors": [
		"LegoMinecraft Team"
	],
	"contact": {
		"homepage": "https://github.com/JinRuiMaoMao/Lego-Minecraft",
		"sources": "https://github.com/JinRuiMaoMao/Lego-Minecraft",
		"issues": "https://github.com/JinRuiMaoMao/Lego-Minecraft/issues"
	},
	"license": "MIT",
	"icon": "assets/legominecraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.legominecraft.LegoMinecraftMod"
		],
		"client": [
			"com.legominecraft.client.LegoMinecraftClient",
			"com.legominecraft.client.LegoMultipartClient"
		],
		"jade": [
			"com.legominecraft.compat.LegoJadeRegistration"
		]
	},
	"mixins": [
		{
			"config": "legominecraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"libmultipart": ">=0.13.0-pre.3",
		"libblockattributes": "*",
		"libnetworkstack": "*"
	},
	"suggests": {
		"jade": "*"
	}
}
