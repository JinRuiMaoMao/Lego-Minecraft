{
	"schemaVersion": 1,
	"id": "legominecraft",
	"version": "${version}",
	"name": "Lego Minecraft",
	"description": "Adds colorful Lego bricks to Minecraft — build anything with classic studded blocks!",
	"authors": [
		"LegoMinecraft Team"
	],
	"license": "MIT",
	"icon": "assets/legominecraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.legominecraft.LegoMinecraftMod"
		],
		"client": [
			"com.legominecraft.client.LegoMinecraftClient",
			"com.legominecraft.client.LegoMultipartClient"
		],
		"jade": [
			"com.legominecraft.compat.LegoJadeRegistration"
		]
	},
	"mixins": [
		{
			"config": "legominecraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"libmultipart": ">=0.13.0-pre.3",
		"libblockattributes": "*",
		"libnetworkstack": "*"
	},
	"suggests": {
		"jade": "*"
	}
}
